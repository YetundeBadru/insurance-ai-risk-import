# mock = offline deterministic stand-in (default); anthropic = real model
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# cost tracking (USD per 1M tokens)
PRICE_IN_PER_M=3
PRICE_OUT_PER_M=15

# Free-tier providers (set LLM_PROVIDER to gemini, groq or openrouter)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# LLM_MODEL must be a model name from your provider's list (names change often)
# LLM_MIN_INTERVAL=4   # seconds between calls, to respect free-tier rate limits
